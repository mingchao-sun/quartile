{
  "manifest_version": 3,
  "name": "Quartile",
  "version": "1.0.0",
  "description": "Journal and citation metrics beside papers on researchmap, with optional JCR, CAS, CCF and warning-list tables. Unofficial; not affiliated with researchmap or JST.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://researchmap.jp/*",
    "https://api.openalex.org/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://researchmap.jp/*"],
      "js": ["i18n.js", "content.js"],
      "css": ["style.css"]
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Quartile"
  }
}
